# このファイルは「ひな形」です。実際の値は書かず、コピーして .env を作り、
# .env の方に実際の値を入れてください(.env は.gitignoreで除外済み・絶対にコミットしない)。
#
# GitHub Actions上では、これらの値は .env ファイルではなく
# リポジトリの Settings > Secrets and variables > Actions に登録します。

# --- Google Sheets ---
# Google Cloudで発行したサービスアカウントの鍵ファイル(JSON)の中身を
# 1行の文字列としてそのまま貼り付ける。
GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", "...": "..."}

# スプレッドシートのURLに含まれるID部分
# 例: https://docs.google.com/spreadsheets/d/【この部分】/edit
SPREADSHEET_ID=

# シート(タブ)名。省略時は Sheet1 が使われる。
SHEET_NAME=Sheet1

# --- note ---
# scripts/note_login_bootstrap.py で生成した note_storage_state.json の中身
NOTE_STORAGE_STATE={"cookies": [...], "origins": [...]}

# --- Craft (Phase4で使用予定。現時点では未使用) ---
# CRAFT_API_URL=
# CRAFT_API_KEY=
